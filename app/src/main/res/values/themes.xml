<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Platform theme only (no AppCompat): smaller APK and faster cold start on the A100.
        A solid window background means the system draws no wallpaper behind us.
    -->
    <style name="Theme.Obsidian" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="obsAccent">@color/accent</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorControlHighlight">@color/ripple</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <!-- Accent choices (settings > Look). Mint is the base theme above. -->
    <style name="Theme.Obsidian.Blue">
        <item name="obsAccent">@color/accent_blue</item>
        <item name="android:colorAccent">@color/accent_blue</item>
    </style>

    <style name="Theme.Obsidian.Amber">
        <item name="obsAccent">@color/accent_amber</item>
        <item name="android:colorAccent">@color/accent_amber</item>
    </style>

    <style name="Theme.Obsidian.Violet">
        <item name="obsAccent">@color/accent_violet</item>
        <item name="android:colorAccent">@color/accent_violet</item>
    </style>

    <style name="Theme.Obsidian.White">
        <item name="obsAccent">@color/accent_white</item>
        <item name="android:colorAccent">@color/accent_white</item>
    </style>

    <!--
        The platform parent matters for radios built in code (the accent picker): without it they
        lose the default radio style, so they draw no circle and ignore taps.
    -->
    <style name="SettingsRadio" parent="android:Widget.DeviceDefault.CompoundButton.RadioButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:textColor">@color/text_label</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="SettingsSection">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">32dp</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">?attr/obsAccent</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>
