<?xml version="1.0" encoding="utf-8"?>
<!--
    No root background: the window background already paints @color/bg, so the
    home screen costs a single full-screen fill per frame on the GE8300.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/home"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingTop="40dp"
        android:paddingEnd="40dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/clock_block"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:longClickable="true"
                android:orientation="vertical">

                <TextClock
                    android:id="@+id/clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-thin"
                    android:format12Hour="h:mm"
                    android:format24Hour="HH:mm"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.03"
                    android:textColor="@color/text_primary"
                    android:textSize="132sp" />

                <TextClock
                    android:id="@+id/date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:format12Hour="EEEE, d MMMM"
                    android:format24Hour="EEEE, d MMMM"
                    android:textColor="@color/text_secondary"
                    android:textSize="24sp" />
            </LinearLayout>

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- GPS speed; hidden while the speedometer is off in settings. -->
            <LinearLayout
                android:id="@+id/speed_block"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:background="?android:attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="end"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/speed_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-thin"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.03"
                    android:text="@string/drive_speed_none"
                    android:textColor="@color/text_primary"
                    android:textSize="112sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/drive_unit"
                    android:textColor="?attr/obsAccent"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/speed_trip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:singleLine="true"
                    android:textColor="@color/text_secondary"
                    android:textSize="17sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/maintenance_banner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/bg_tile"
            android:minHeight="56dp"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:textColor="@color/warning"
            android:textSize="18sp"
            android:visibility="gone" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <include
            android:id="@+id/now_playing"
            layout="@layout/view_now_playing" />

        <LinearLayout
            android:id="@+id/shortcuts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="horizontal">

            <include
                android:id="@+id/shortcut_maps"
                layout="@layout/item_shortcut" />

            <include
                android:id="@+id/shortcut_zlink"
                layout="@layout/item_shortcut" />

            <include
                android:id="@+id/shortcut_phone"
                layout="@layout/item_shortcut" />

            <include
                android:id="@+id/shortcut_radio"
                layout="@layout/item_shortcut" />

            <include
                android:id="@+id/shortcut_apps"
                layout="@layout/item_shortcut" />
        </LinearLayout>
    </LinearLayout>

    <include
        android:id="@+id/drawer"
        layout="@layout/view_drawer"
        android:visibility="gone" />

    <include
        android:id="@+id/idle_clock"
        layout="@layout/view_idle_clock"
        android:visibility="gone" />
</FrameLayout>
